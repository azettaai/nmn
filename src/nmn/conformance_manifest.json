    "ray": {
      "oracle": "radial_yat_attention_v1",
      "outputs": ["features", "output"],
      "gradients": ["query", "key", "value", "projection", "bias", "epsilon"],
      "masking": ["causal", "padding_when_supported"],
      "layout": "[batch, sequence, heads, head_features]"
    }
